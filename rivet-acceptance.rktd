#hasheq(
 (version . 1)
 (requirements
  . (#hasheq((kind . contract) (platforms . (windows)))
     #hasheq((kind . bridge) (platforms . (windows)))
     #hasheq((kind . native-build) (platforms . (windows)))
     #hasheq((kind . package) (platforms . (windows)))
     #hasheq((kind . native-ui) (platforms . (windows)))))
 (suites
  . (#hasheq((id . core-contract)
             (kind . contract)
             (platforms . (windows))
             (command . ("raco" "test" "racket/"))
             (timeout-seconds . 900))
     #hasheq((id . embedded-wire)
             (kind . bridge)
             (platforms . (windows))
             (command . ("raco" "test" "racket/tests/rvt1-smoke.rkt"))
             (timeout-seconds . 300))
     #hasheq((id . native-host)
             (kind . native-build)
             (platforms . (windows))
             (command . ("raco" "rivet" "build"))
             (timeout-seconds . 1800))
     #hasheq((id . windows-package)
             (kind . package)
             (platforms . (windows))
             (command . ("racket" "scripts/acceptance/package.rkt"))
             (timeout-seconds . 1800)
             (evidence . (".rivet/acceptance/windows/package.json")))
     #hasheq((id . windows-native-ui)
             (kind . native-ui)
             (platforms . (windows))
             (command . ("pwsh" "-NoProfile" "-File" "scripts/e2e/e2e-windows.ps1"))
             (timeout-seconds . 600)
             (evidence . (".rivet/acceptance/windows/interaction-trace.json"
                          ".rivet/acceptance/windows/accessibility.json"))))))
